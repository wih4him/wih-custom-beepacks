SolidEnergy
{
$basetexture "wih/fizz/fizzrestrictorgate_strands_teal"
$flowmap "effects/fizzler_flow"
$flowbounds "effects/fizzler_bounds_center"
$FLOW_NOISE_TEXTURE "effects/fizzler_noise"
$FLOW_UVSCROLLDISTANCE "0.40"
$FLOW_TIMEINTERVALINSECONDS "1.2"
$FLOW_NOISE_SCALE 0.006
$FLOW_LERPEXP 1.5
$FLOW_WORLDUVSCALE 0.008
$FLOW_NORMALUVSCALE 0.008
$FLOW_COLOR "[0.024 0.19 0.23]"
$FLOW_VORTEX_COLOR "[0.6 2.4 2.8]"
$surfaceprop glass
"%keywords" Portal2
$translucent 1
$additive 1
$FLOW_VORTEX_POS1 "[-160 64 64]"
$FLOW_VORTEX_SIZE 35
"srgb_pc?$outputintensity" 2.3
"!srgb_pc?$outputintensity" 1.7
Proxies
{
Sine
{
sineperiod 3
sinemin 0.016
sinemax 0.03
timeoffset 0
resultVar "$FLOW_COLOR[0]"
}
Sine
{
sineperiod 3
sinemin 0.13
sinemax 0.24
timeoffset 0
resultVar "$FLOW_COLOR[1]"
}
Sine
{
sineperiod 3
sinemin 0.16
sinemax 0.29
timeoffset 0
resultVar "$FLOW_COLOR[2]"
}
FizzlerVortex
{
}
}
}
