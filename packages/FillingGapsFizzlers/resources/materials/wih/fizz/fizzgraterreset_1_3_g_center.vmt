SolidEnergy
{
$basetexture "effects/fizzler_ripples_dim"
$flowmap "effects/fizzler_flow"
$flowbounds "effects/fizzler_bounds_center"
$FLOW_NOISE_TEXTURE "effects/fizzler_noise"
$FLOW_UVSCROLLDISTANCE "0.25"
$FLOW_TIMEINTERVALINSECONDS "1.2"
$FLOW_NOISE_SCALE 0.003
$FLOW_LERPEXP 1.5
$FLOW_WORLDUVSCALE 0.008
$FLOW_NORMALUVSCALE 0.008
$FLOW_COLOR "[0.011 0.058 0.048]"
$FLOW_VORTEX_COLOR "[0.3 1.6 1.3]"
$surfaceprop glass
"%keywords" Portal2
$translucent 1
$additive 1
$FLOW_VORTEX_POS1 "[-160 64 64]"
$FLOW_VORTEX_SIZE 35
"srgb_pc?$outputintensity" 0.92
"!srgb_pc?$outputintensity" 0.68
Proxies
{
FizzlerVortex
{
}
}
}
