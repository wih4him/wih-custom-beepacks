SolidEnergy
{
$basetexture "wih/fizz/fgf_swirl"
$flowmap "wih/fizz/fgf_flow_b"
$flowbounds "effects/fizzler_bounds"
$FLOW_NOISE_TEXTURE "effects/fizzler_noise"
$FLOW_UVSCROLLDISTANCE "0.15"
$FLOW_TIMEINTERVALINSECONDS "3.5"
$FLOW_NOISE_SCALE 0.006
$FLOW_LERPEXP 1.5
$FLOW_WORLDUVSCALE 0.008
$FLOW_NORMALUVSCALE 0.008
$FLOW_COLOR "[0.14 0.02 0.23]"
$FLOW_VORTEX_COLOR "[1.7 0.3 2.8]"
$surfaceprop glass
"%keywords" Portal2
$translucent 1
$additive 1
$FLOW_VORTEX_SIZE 35
"srgb_pc?$outputintensity" 2.3
"!srgb_pc?$outputintensity" 1.7
Proxies
{
Sine
{
sineperiod 40
sinemin 0
sinemax 0.14
timeoffset 0
resultVar "$FLOW_COLOR[0]"
}
Sine
{
sineperiod 40
sinemin 0
sinemax 0.02
timeoffset 0
resultVar "$FLOW_COLOR[1]"
}
Sine
{
sineperiod 40
sinemin 0
sinemax 0.23
timeoffset 0
resultVar "$FLOW_COLOR[2]"
}
Sine
{
sineperiod 40
sinemin 0
sinemax 1.7
timeoffset 0
resultVar "$FLOW_VORTEX_COLOR[0]"
}
Sine
{
sineperiod 40
sinemin 0
sinemax 0.3
timeoffset 0
resultVar "$FLOW_VORTEX_COLOR[1]"
}
Sine
{
sineperiod 40
sinemin 0
sinemax 2.8
timeoffset 0
resultVar "$FLOW_VORTEX_COLOR[2]"
}
FizzlerVortex
{
}
}
}
