SolidEnergy
{
$basetexture "wih/fizz/fgf_blend"
$flowmap "wih/fizz/fgf_flow_a"
$flowbounds "effects/fizzler_bounds_r"
$FLOW_NOISE_TEXTURE "wih/fizz/fgf_noise_a"
$FLOW_UVSCROLLDISTANCE "0.25"
$FLOW_TIMEINTERVALINSECONDS "0.7"
$FLOW_NOISE_SCALE 0.01
$FLOW_LERPEXP 1.5
$FLOW_WORLDUVSCALE 0.008
$FLOW_NORMALUVSCALE 0.008
$FLOW_COLOR "[0.10 0.02 0.08]"
$FLOW_VORTEX_COLOR "[2.6 0.5 2.2]"
$surfaceprop glass
"%keywords" Portal2
$translucent 1
$additive 1
$FLOW_VORTEX_SIZE 10
"srgb_pc?$outputintensity" 1.265
"!srgb_pc?$outputintensity" 0.935
Proxies
{
Sine
{
sineperiod 36
sinemin 0.1
sinemax 0.1
timeoffset 0
resultVar "$FLOW_COLOR[0]"
}
Sine
{
sineperiod 36
sinemin 0.02
sinemax 0.015
timeoffset 0
resultVar "$FLOW_COLOR[1]"
}
Sine
{
sineperiod 36
sinemin 0.08
sinemax 0.05
timeoffset 0
resultVar "$FLOW_COLOR[2]"
}
FizzlerVortex
{
}
}
}
